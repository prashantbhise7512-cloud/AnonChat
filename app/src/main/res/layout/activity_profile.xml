<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="@string/profile_title"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/ToolbarTitle" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- Profile Photo Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/ivProfilePic"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/ic_default_avatar"
                            app:civ_border_color="?attr/colorPrimary"
                            app:civ_border_width="3dp" />

                        <ImageView
                            android:id="@+id/ivCameraIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_send_button"
                            android:contentDescription="Change photo"
                            android:padding="6dp"
                            android:src="@drawable/ic_camera" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvChangePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="@string/profile_change_photo"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRemovePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:padding="4dp"
                            android:text="@string/profile_remove_photo"
                            android:textColor="#FFD32F2F"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUniqueId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_id_badge"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="ID: #A8F4C2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Profile Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- View Mode Container -->
                    <LinearLayout
                        android:id="@+id/llProfileViewMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- View Mode Items... -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="@string/profile_display_name"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvViewName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/not_specified"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="@string/gender"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvViewGender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/not_specified"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="@string/age"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvViewAge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/not_specified"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="@string/city"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvViewCity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/not_specified"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Button: Edit Profile Details -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditProfileDetails"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/btn_edit_profile"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="#E3F2FD"
                            app:cornerRadius="12dp"
                            app:elevation="0dp" />

                    </LinearLayout>

                    <!-- Edit Mode Container -->
                    <LinearLayout
                        android:id="@+id/llProfileEditMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Display Name -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDisplayName"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:hint="@string/profile_name_hint"
                            app:counterEnabled="true"
                            app:counterMaxLength="50">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDisplayName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:maxLength="50" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Gender -->
                        <TextView
                            android:id="@+id/tvGenderLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/profile_gender_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerGender"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="12dp" />

                        <!-- Age -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilAge"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:hint="@string/profile_age_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- City -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCity"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/profile_city_hint"
                            app:counterEnabled="true"
                            app:counterMaxLength="100">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPostalAddress"
                                android:maxLength="100" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Actions: Save & Cancel -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSaveProfile"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/btn_save_changes"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:backgroundTint="?attr/colorPrimary"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCancelEdit"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="@string/cancel"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp"
                                app:strokeColor="#E2E8F0"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Hidden buttons kept for backwards compatibility -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContinueWithoutProfile"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Privacy note -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawablePadding="6dp"
                        android:text="@string/profile_private_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone" />

            <!-- Error -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFC62828"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- App Theme Color Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_theme_color"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/choose_theme_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Blue Theme -->
                        <FrameLayout
                            android:id="@+id/themeBlue"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_circle_blue"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/checkBlue"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_sent"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Green Theme -->
                        <FrameLayout
                            android:id="@+id/themeGreen"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_circle_green"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/checkGreen"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_sent"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Purple Theme -->
                        <FrameLayout
                            android:id="@+id/themePurple"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_circle_purple"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/checkPurple"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_sent"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Red Theme -->
                        <FrameLayout
                            android:id="@+id/themeRed"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_circle_red"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/checkRed"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_sent"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Teal Theme -->
                        <FrameLayout
                            android:id="@+id/themeTeal"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_circle_teal"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/checkTeal"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_sent"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Dark Theme -->
                        <FrameLayout
                            android:id="@+id/themeDark"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_circle_dark"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/checkDark"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_sent"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account & Privacy Single Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccountPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAccountPrivacy"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="20dp"
                    android:text="@string/account_privacy"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_back"
                    app:iconGravity="end"
                    app:iconTint="@color/text_secondary"
                    app:rippleColor="@color/primary_light" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
